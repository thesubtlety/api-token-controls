          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-8ad90fe7",
            "fc-9b1ee6b0"
          ]
        },
        {
          "name": "Key expiration",
          "effect": "limit_lifetime",
          "applies_to": [
            "langsmith-1",
            "langsmith-2"
          ],
          "what": "Per-key expiry in days; default never.",
          "setting": "API key create dialog",
          "plan": null,
          "default": "off",
          "level": "app",
          "evidence_refs": [
            "fc-8ad90fe7",
            "fc-2ccacbe4"
          ]
        },
        {
          "name": "max_pat_expiry_days / max_service_key_expiry_days",
          "effect": "limit_lifetime",
          "applies_to": [
            "langsmith-1",
            "langsmith-2"
          ],
          "what": "Org-level maximum expiry fields in the org API schema (behaviour not described in guides).",
          "setting": "PATCH /api/v1/orgs/current/info",
          "plan": null,
          "default": "unknown",
          "level": "org",
          "evidence_refs": [
            "fc-9cdc042c"
          ]
        },
        {
          "name": "Service key workspace scope and roles",
          "effect": "limit_scope",
          "applies_to": [
            "langsmith-2"
          ],
          "what": "Limit keys to specific workspaces and (Enterprise) a workspace role.",
          "setting": "Settings > API Keys > Service",
          "plan": "Enterprise (roles)",
          "default": "varies",
          "level": "app",
          "evidence_refs": [
            "fc-8ad90fe7"
          ]
        },
        {
          "name": "Service key creation limited to admins",
          "effect": "other",
          "applies_to": [
            "langsmith-2"
          ],
          "what": "Only admins can create service keys, so non-admin members cannot create them.",
          "setting": "Organization roles (Settings > Members and roles)",
          "plan": null,
          "default": "on",
          "level": "org",
          "evidence_refs": [
            "fc-2ccacbe4"
          ]
        }
