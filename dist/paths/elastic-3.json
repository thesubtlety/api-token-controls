  "providers": [
    {
      "id": "elastic",
      "name": "Elastic Cloud",
      "scope_notes": "Covers Elastic Cloud (Elastic Cloud Hosted / Serverless, Elasticsearch). Covers Elastic Cloud org API keys and Elasticsearch-level credentials on ECH, Serverless and self-managed; Elasticsearch audit logging needs a qualifying subscription, and the org-level Cloud audit trail exists only on FedRAMP Moderate.",
      "controls": [
        {
          "name": "Role descriptors / access on API key",
          "effect": "limit_scope",
          "applies_to": [
            "elastic-2",
            "elastic-3"
          ],
          "what": "Restricts the key to given privileges and indices.",
          "setting": "POST /_security/api_key role_descriptors; POST /_security/cross_cluster/api_key access",
          "plan": null,
          "default": "off",
          "level": "app",
          "evidence_refs": [
            "fc-b9e9826b",
            "fc-2c4ceef9"
          ]
        },
        {
          "name": "API key expiration (Elasticsearch)",
          "effect": "limit_lifetime",
          "applies_to": [
            "elastic-2",
            "elastic-3"
          ],
          "what": "Optional expiry; none by default.",
          "setting": "Kibana API keys > Create API key; expiration field",
          "plan": null,
          "default": "off",
          "level": "app",
          "evidence_refs": [
            "fc-e084e481",
            "fc-2c4ceef9"
          ]
        },
        {
          "name": "Invalidate API keys",
          "effect": "revoke",
          "applies_to": [
            "elastic-2",
            "elastic-3"
          ],
          "what": "Invalidated keys fail authentication; can target by owner, user or realm.",
          "setting": "DELETE /_security/api_key; Kibana API keys > Delete",
          "plan": null,
          "default": "unknown",
          "level": "org",
          "evidence_refs": [
            "fc-68c78025"
          ]
        },
        {
          "name": "IP filters (network security policies)",
          "effect": "limit_network",
          "applies_to": [
            "elastic-2",
            "elastic-3",
            "elastic-4"
          ],
          "what": "Rejects deployment/project traffic from non-allowed IPs with 403.",
          "setting": "Organization > Network security > IP filter; apply to deployments",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-c2207027"
          ]
        },
        {
          "name": "manage_security privilege (cross-cluster API key creation)",
          "effect": "disable",
          "applies_to": [
            "elastic-3"
          ],
          "what": "Creating or updating a cross-cluster API key needs manage_security and an Enterprise license; users without it cannot create one.",
          "setting": "Elasticsearch role cluster privileges",
          "plan": "Enterprise",
          "default": "varies",
          "level": "org",
          "evidence_refs": [
            "fc-e084e481"
          ]
        }
      ],
      "no_control": [],
      "controls_unknown": [
        "IP restriction for the Elastic Cloud API (api.elastic-cloud.com) used with Cloud API keys.",
        "Whether an org can block creation of Cloud API keys with no expiry (Never).",
        "Org-level audit log of Cloud API key creation/use outside FedRAMP Moderate.",
        "Whether ES API keys owned by a SAML user stop working when the user is removed in the IdP.",
        "Whether xpack.security.authc.api_key.enabled can be set in ECH user settings.",
        "Whether Cloud API key revocation affects in-flight requests."
      ]
    }
