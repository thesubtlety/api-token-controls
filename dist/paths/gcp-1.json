            "stage": "revoke",
            "notes": "Kills minted tokens too"
          }
        ],
        "correlation_keys": [
          "serviceAccountKeyName",
          "principalEmail",
          "callerIp"
        ],
        "anomaly_cues": [
          "Key used from a new callerIp",
          "Auto-disable by gcp-compromised-key-response",
          "Key created then used from outside your network",
          "Key usage after long inactivity"
        ],
        "containment": {
          "steps": "Disable the SA (cuts all tokens), then delete the key; rotate dependents.",
          "kills_existing": "partial",
          "notes": "Key deletion alone leaves minted tokens valid (up to 1h, or 12h if extended)."
        },
        "sample_query": "protoPayload.authenticationInfo.serviceAccountKeyName:\"KEY_ID\"",
        "unknown": [
          "Retention beyond 400/30 days requires sinks"
        ],
