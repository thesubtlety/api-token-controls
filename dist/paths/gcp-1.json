{
  "schema_version": "2.0.0",
  "title": "API Token Controls",
  "as_of": "2026-10-09",
  "updated": "2026-10-14",
  "scope": "Admin controls, logging and revocation for API credentials on SaaS platforms. Sourced from vendor documentation; not an audit of any tenant.",
  "definitions": {
    "supported": "Documented for this credential.",
    "conditional": "Documented, with plan, policy or endpoint conditions.",
    "excluded": "The named control explicitly does not cover this credential.",
    "not_supported": "Vendor documentation states this credential lacks the control.",
    "unknown": "No source found either way. Not a negative finding.",
    "not_verified": "No source found either way. Not a negative finding.",
    "not_applicable": "Does not apply to this credential.",
    "limited": "Documented for a narrower case only."
  },
  "providers": [
    {
      "id": "gcp",
      "name": "Google Cloud",
      "scope_notes": "Covers Google Cloud (IAM, API Keys, Cloud Storage). Covers Google Cloud project/org credentials; org policy constraints and VPC Service Controls need an organization resource; Workspace user OAuth and domain-wide delegation are in the separate `google` platform.",
      "controls": [
        {
          "name": "iam.managed.disableServiceAccountKeyCreation (legacy iam.disableServiceAccountKeyCreation)",
          "effect": "disable",
          "applies_to": [
            "gcp-1",
            "gcp-5"
          ],
          "what": "Blocks creation of new service account keys and SA HMAC keys.",
          "setting": "Organization policies > constraint; gcloud resource-manager org-policies enable-enforce",
          "plan": null,
          "default": "varies",
          "level": "org",
          "evidence_refs": [
            "fc-7af2d5e5"
          ]
        },
        {
          "name": "iam.managed.disableServiceAccountKeyUpload",
          "effect": "disable",
          "applies_to": [
            "gcp-1"
          ],
          "what": "Blocks uploading external public keys to service accounts.",
          "setting": "Organization policies",
          "plan": null,
          "default": "varies",
          "level": "org",
          "evidence_refs": [
            "fc-7af2d5e5"
          ]
        },
        {
          "name": "constraints/iam.serviceAccountKeyExpiryHours",
          "effect": "limit_lifetime",
          "applies_to": [
            "gcp-1"
          ],
          "what": "Sets an expiry (1h to 2160h) for newly created SA keys.",
          "setting": "Organization policies",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-7af2d5e5",
            "fc-6fc9753d"
          ]
        },
        {
          "name": "iam.serviceAccountKeyExposureResponse",
          "effect": "revoke",
          "applies_to": [
            "gcp-1",
            "gcp-4"
          ],
          "what": "Auto-disables SA keys and SA-bound API keys that Google detects as exposed.",
          "setting": "Organization policies (DISABLE_KEY or WAIT_FOR_ABUSE)",
          "plan": null,
          "default": "on",
          "level": "org",
          "evidence_refs": [
            "fc-7af2d5e5"
          ]
        },
        {
          "name": "Disable service account (serviceAccounts.disable)",
          "effect": "revoke",
          "applies_to": [
            "gcp-1",
            "gcp-2",
            "gcp-3",
            "gcp-4"
          ],
          "what": "Immediately disables the SA, which is the documented way to cut off already-issued short-lived tokens.",
          "setting": "IAM > Service accounts > Disable; POST .../serviceAccounts/SA_ID:disable",
          "plan": null,
          "default": "unknown",
          "level": "app",
          "evidence_refs": [
            "fc-e9b2abab",
            "fc-6fc9753d"
          ]
        },
        {
          "name": "Delete / disable service account key",
          "effect": "revoke",
          "applies_to": [
            "gcp-1"
          ],
          "what": "Stops the key from minting new tokens; tokens already minted stay valid until expiry.",
          "setting": "IAM > Service accounts > Keys; DELETE .../keys/KEY_ID",
          "plan": null,
          "default": "unknown",
          "level": "app",
          "evidence_refs": [
            "fc-6fc9753d",
            "fc-65ab24ea"
          ]
        },
        {
          "name": "VPC Service Controls",
          "effect": "limit_network",
          "applies_to": [
            "gcp-1",
            "gcp-2",
            "gcp-3",
            "gcp-4",
            "gcp-5"
          ],
          "what": "Service perimeters with ingress rules limit API access by network origin and identity, even with stolen credentials.",
          "setting": "Security > VPC Service Controls",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-c4499f95"
          ]
        }
      ],
      "no_control": [
        {
          "path_id": "gcp-1",
          "what": "Deleting a key does not revoke access tokens already minted from it.",
          "kind": "kill",
          "evidence_refs": [
            "fc-6fc9753d"
          ]
        },
        {
          "path_id": "gcp-1",
          "what": "Keys never expire unless the expiry org policy is set.",
          "kind": "expiry",
          "evidence_refs": [
            "fc-6fc9753d"
          ]
        }
      ],
      "controls_unknown": [
        "Whether existing keys created before iam.serviceAccountKeyExpiryHours was set get an expiry (docs say 'newly created').",
        "Federated (STS) access token lifetime.",
        "Whether API keys support an expiry setting.",
        "Which audit field identifies the API key or HMAC access ID used on a data-plane request.",
        "Whether GetKeyString/lookupKey calls are logged for keys.lookupKey.",
        "Plan/pricing for VPC Service Controls (needs organization)."
      ]
    }
  ],
  "auth_paths": [
    {
      "id": "gcp-1",
      "provider_id": "gcp",
      "name": "Service account keys (user-managed)",
      "family": "jwt",
      "principal": "service",
      "lifecycle": "current",
      "reviewed_at": "2026-10-12",
      "authentication": {
        "summary": "A JSON (or P12) private key for a service account. The holder signs a JWT and exchanges it for an OAuth 2.0 access token, then calls Google APIs as the service account.",
        "evidence_refs": [
          "fc-6fc9753d",
          "fc-9ac8bb6a",
          "fc-3d9aa972"
        ]
      },
      "federation": {
        "status": "not_applicable",
        "details": "Keys authenticate the service account directly. Context-Aware Access policies 'apply only to users', so IdP/CAA conditions on human users do not gate key use. No doc states an SSO check on keys.",
        "evidence_refs": [
          "fc-214cc15d",
          "fc-2e7078e9"
        ]
      },
      "ip_restriction": {
        "status": "conditional",
        "enforcement_stage": "api_request",
        "boundary": "No IP list on the key itself. VPC Service Controls perimeters with ingress rules (by identity and IP) restrict API requests to protected services; services outside the perimeter are not covered.",
        "evidence_refs": [
          "fc-c4499f95",
          "fc-57894375"
        ]
      },
      "lifetime": {
        "basis": "policy",
        "default_seconds": null,
        "maximum_seconds": null,
        "configurable": "yes",
        "summary": "Never expire by default; iam.serviceAccountKeyExpiryHours can set 1h-2160h (90 days) for new keys",
        "evidence_refs": [
          "fc-6fc9753d",
          "fc-7af2d5e5"
        ]
      },
      "renewal": {
        "mechanism": "credential_reuse",
        "expiry_basis": "Key reused to mint new 1-hour access tokens until the key is deleted, disabled or expires",
        "summary": "Rotate by creating a new key and deleting the old one (up to 10 keys per SA).",
        "evidence_refs": [
          "fc-6fc9753d",
          "fc-3d9aa972"
        ]
      },
      "administration": {
        "summary": "Org policy can block key creation and key upload; for orgs created on/after 2024-05-03 creation is blocked by default. Exposed keys are auto-disabled by default.",
        "conditions": "Org policies need an organization resource.",
        "evidence_refs": [
          "fc-7af2d5e5"
        ]
      },
      "identity": {
        "sso": {
          "status": "unknown",
          "details": "",
          "evidence_refs": []
        },
        "offboard": {
          "status": "not_applicable",
          "details": "Keys belong to a service account; access ends when the service account is disabled or deleted, not when a user leaves.",
          "evidence_refs": [
            "fc-c6d6c1f9"
          ]
        },
        "inventory": {
          "status": "yes",
          "details": "Cloud Asset Inventory supports iam.googleapis.com/ServiceAccountKey in its list/search/export APIs across an organization.",
          "evidence_refs": [
            "fc-55f8493d"
          ]
        }
      },
      "how": {
        "inventory": {
          "ui": "Security > Asset Inventory > Resource search, filter asset type iam.googleapis.com/ServiceAccountKey; per SA: IAM & Admin > Service accounts > (SA) > Keys",
          "api": "GET https://cloudasset.googleapis.com/v1/{scope}:searchAllResources?assetTypes=iam.googleapis.com/ServiceAccountKey",
          "cli": "gcloud asset search-all-resources --scope=organizations/ORG_ID --asset-types=iam.googleapis.com/ServiceAccountKey",
          "evidence_refs": [
            "fc-2177519d",
            "fc-55f8493d",
            "fc-889bbaa1"
          ]
        },
        "expiry": {
          "ui": "Organization policies > constraints/iam.serviceAccountKeyExpiryHours > Manage policy",
          "api": null,
          "cli": "gcloud resource-manager org-policies allow constraints/iam.serviceAccountKeyExpiryHours 2160h --organization=ORG_ID",
          "evidence_refs": [
            "fc-7af2d5e5"
          ]
        },
        "usage": {
          "ui": "Logging > Logs Explorer, filter protoPayload.authenticationInfo.serviceAccountKeyName=\"//iam.googleapis.com/projects/P/serviceAccounts/SA/keys/KEY_ID\"; per-key counts: Metrics Explorer > Service account key authentication events",
          "api": null,
          "cli": null,
          "evidence_refs": [
            "fc-9ac8bb6a",
            "fc-858b9298",
            "fc-5c044d8c"
          ]
        },
        "reads": {
          "ui": "IAM & Admin > Audit Logs > select service > Permission types: Data Read > Save; then Logs Explorer filter serviceAccountKeyName",
          "api": "Add auditConfigs {logType: DATA_READ} to the project/folder/org IAM policy (setIamPolicy)",
          "cli": "gcloud projects set-iam-policy PROJECT_ID policy.yaml",
          "evidence_refs": [
            "fc-a6bc72ba",
            "fc-5c044d8c"
          ]
        }
      },
      "incident_response": {
        "token_format": {
          "prefix": null,
          "notes": "JSON file with \"type\": \"service_account\", private_key_id (key ID) and client_email."
        },
        "log_sources": [
          {
            "name": "Cloud Audit Logs - Admin Activity",
            "notes": "Always on; key create/delete/disable. _Required bucket keeps 400 days."
          },
          {
            "name": "Cloud Audit Logs - Data Access",
            "notes": "Off by default except BigQuery; needed to see reads. _Default bucket 30 days."
