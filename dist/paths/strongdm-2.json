          "effect": "limit_scope",
          "applies_to": [
            "strongdm-1",
            "strongdm-2"
          ],
          "what": "Each admin token or API key gets only the admin permissions chosen at creation.",
          "setting": "Create Admin Token / Create API Key page; --permissions",
          "plan": null,
          "default": "varies",
          "level": "app",
          "evidence_refs": [
            "fc-97954b59",
            "fc-7f30f72d",
            "fc-494307d6",
            "fc-8ffe802d"
          ]
        },
        {
