          "effect": "limit_lifetime",
          "applies_to": [
            "strongdm-1",
            "strongdm-2"
          ],
          "what": "Set an expiry at creation; 'never' is an allowed choice.",
          "setting": "Create page expiry selector; --duration",
          "plan": null,
          "default": "varies",
          "level": "app",
          "evidence_refs": [
            "fc-97954b59",
            "fc-7f30f72d",
            "fc-8ffe802d"
          ]
        },
        {
          "name": "Delete API key",
          "effect": "revoke",
          "applies_to": [
            "strongdm-2"
          ],
          "what": "Deleted API keys are invalidated instantly.",
          "setting": "Principals > Tokens; sdm admin tokens delete",
          "plan": null,
          "default": "varies",
          "level": "org",
          "evidence_refs": [
            "fc-7f30f72d"
          ]
        },
        {
          "name": "Delete tokens on user suspension",
          "effect": "revoke",
          "applies_to": [
            "strongdm-1",
            "strongdm-2"
          ],
          "what": "When suspending a user, the Admin UI lists their tokens and keys and asks whether to delete them.",
          "setting": "Users > Suspend user",
          "plan": null,
          "default": "varies",
          "level": "user",
          "evidence_refs": [
            "fc-97954b59",
            "fc-7f30f72d"
          ]
        },
        {
          "name": "Permission level: Manage service accounts, admin tokens, and API keys",
          "effect": "other",
          "applies_to": [
            "strongdm-1",
            "strongdm-2",
            "strongdm-3"
          ],
          "what": "Only the Administrator permission level can create or manage admin tokens, API keys, and service accounts; other levels cannot.",
          "setting": "Principals > Users > (user) > Settings > Permission Level",
          "plan": null,
          "default": "on",
          "level": "user",
          "evidence_refs": [
            "fc-087adfd5"
          ]
        },
        {
          "name": "sdm admin users suspend --cascade",
          "effect": "revoke",
          "applies_to": [
            "strongdm-2"
          ],
          "what": "Suspending a user with --cascade also suspends that user's linked API keys.",
          "setting": "CLI: sdm admin users suspend --cascade",
          "plan": null,
          "default": "off",
          "level": "user",
          "evidence_refs": [
            "fc-85830931"
          ]
        }
