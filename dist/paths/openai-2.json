      "controls": [
        {
          "name": "API Key Governance",
          "effect": "disable",
          "applies_to": [
            "openai-1",
            "openai-2"
          ],
          "what": "Allow only service-account keys, only user-owned project keys, or disable all new API key creation at org or project level.",
          "setting": "Platform settings > API Key Governance",
          "plan": null,
          "default": "unknown",
          "level": "org",
          "evidence_refs": [
            "fc-cda4b87e"
          ]
        },
        {
          "name": "Maximum API key lifetime",
          "effect": "limit_lifetime",
          "applies_to": [
            "openai-1",
            "openai-2"
          ],
          "what": "New keys must expire within the configured limit; project limit cannot exceed org limit.",
          "setting": "Platform settings (organization/general)",
          "plan": null,
          "default": "unknown",
          "level": "org",
          "evidence_refs": [
            "fc-cda4b87e"
          ]
        },
        {
          "name": "IP allowlist",
          "effect": "limit_network",
          "applies_to": [
            "openai-1",
            "openai-2",
            "openai-4"
          ],
          "what": "Reject API requests from IPs outside up to 50 addresses/CIDRs; org or project level.",
          "setting": "Settings > Security > IP allowlist",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-4f6c0e89"
          ]
        },
        {
          "name": "API key permissions (scopes)",
          "effect": "limit_scope",
          "applies_to": [
            "openai-1",
            "openai-2"
          ],
          "what": "Key permissions are intersected with the owner's project role.",
          "setting": "Key create/edit",
          "plan": null,
          "default": "varies",
          "level": "app",
          "evidence_refs": [
            "fc-aabf5d67",
            "fc-637c5e12"
          ]
        },
        {
          "name": "Delete project API key",
          "effect": "revoke",
          "applies_to": [
            "openai-1",
            "openai-2"
          ],
          "what": "Admin deletes a project key; takes effect within a few seconds.",
          "setting": "DELETE /v1/organization/projects/{project_id}/api_keys/{api_key_id}",
          "plan": null,
          "default": "unknown",
          "level": "org",
          "evidence_refs": [
            "fc-a8249c0b",
            "fc-a738cffa"
          ]
        },
        {
          "name": "Delete project service account",
          "effect": "revoke",
          "applies_to": [
            "openai-2",
            "openai-4"
          ],
          "what": "Removes the service account identity.",
          "setting": "DELETE /v1/organization/projects/{project_id}/service_accounts/{service_account_id}",
          "plan": null,
          "default": "unknown",
          "level": "org",
          "evidence_refs": [
            "fc-8c63700e"
          ]
        }
      ],
