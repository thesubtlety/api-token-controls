          "name": "team_member_permissions",
          "effect": "limit_scope",
          "applies_to": [
            "litellm-2"
          ],
          "what": "Controls which key-management routes team members may call; default is read-only key info.",
          "setting": "team_member_permissions on the team",
          "plan": null,
          "default": "on",
          "level": "org",
          "evidence_refs": [
            "fc-ee00c8b3"
          ]
        },
        {
          "name": "allowed_ips",
          "effect": "limit_network",
          "applies_to": [
            "litellm-1",
            "litellm-2",
            "litellm-3",
            "litellm-4"
          ],
          "what": "Only listed client IPs can call proxy endpoints; others get 403.",
          "setting": "general_settings.allowed_ips",
          "plan": "Enterprise",
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-3e5f4bbf"
          ]
        },
        {
          "name": "Key regenerate (rotation)",
          "effect": "revoke",
          "applies_to": [
            "litellm-2",
            "litellm-3"
          ],
          "what": "Issues a new secret; old secret is revoked immediately unless a grace_period is set.",
          "setting": "POST /key/{key}/regenerate",
          "plan": "Enterprise",
          "default": "off",
          "level": "app",
          "evidence_refs": [
            "fc-c8c961a5"
          ]
        },
        {
          "name": "Scheduled key rotation (auto_rotate)",
          "effect": "require_rotation",
          "applies_to": [
            "litellm-2"
          ],
          "what": "Background job regenerates keys on rotation_interval and invalidates the old string.",
          "setting": "auto_rotate + rotation_interval on key; LITELLM_KEY_ROTATION_ENABLED=true",
          "plan": "Enterprise",
          "default": "off",
          "level": "app",
          "evidence_refs": [
            "fc-c8c961a5"
          ]
        },
        {
          "name": "SCIM user deprovisioning",
          "effect": "revoke",
          "applies_to": [
            "litellm-2"
          ],
          "what": "Deprovisioning a user blocks all keys they own and clears them from the auth cache.",
          "setting": "IdP SCIM push / DELETE /scim/v2/Users/{id}",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-b1f46815"
          ]
        },
        {
          "name": "store_audit_logs",
          "effect": "other",
          "applies_to": [
            "litellm-1",
            "litellm-2",
            "litellm-3"
          ],
          "what": "Records create/update/delete/regenerate of keys, teams, users, models.",
          "setting": "litellm_settings.store_audit_logs",
          "plan": "Enterprise",
          "default": "varies",
          "level": "org",
          "evidence_refs": [
            "fc-34776e02"
          ]
        }
