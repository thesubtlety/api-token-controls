          "name": "allowed_routes",
          "effect": "limit_scope",
          "applies_to": [
            "litellm-2",
            "litellm-3"
          ],
          "what": "Restricts which proxy routes a key can call, including admin-owned keys.",
          "setting": "allowed_routes on /key/generate or /key/update",
          "plan": null,
          "default": "off",
          "level": "app",
          "evidence_refs": [
            "fc-c8c961a5"
          ]
        },
