  "providers": [
    {
      "id": "litellm",
      "name": "LiteLLM",
      "scope_notes": "Covers LiteLLM Proxy (AI Gateway). Self-hosted open-source proxy (MIT) with an Enterprise license gating JWT auth, IP filtering, audit logs and key rotation; all controls are operator config on your own deployment.",
      "controls": [
        {
          "name": "key/block",
          "effect": "disable",
          "applies_to": [
            "litellm-2",
            "litellm-3"
          ],
          "what": "Blocks a virtual key; /key/unblock re-enables it.",
          "setting": "POST /key/block",
          "plan": null,
          "default": "off",
          "level": "app",
          "evidence_refs": [
            "fc-c8c961a5"
          ]
        },
        {
          "name": "key/delete",
          "effect": "revoke",
          "applies_to": [
            "litellm-2",
            "litellm-3"
          ],
          "what": "Deletes a virtual key; deletion is recorded in audit logs and the Deleted Keys view.",
          "setting": "POST /key/delete; Admin UI Keys page",
          "plan": null,
          "default": "off",
          "level": "app",
          "evidence_refs": [
            "fc-34776e02",
            "fc-f9271513"
          ]
        },
        {
          "name": "key_generation_settings",
          "effect": "disable",
          "applies_to": [
            "litellm-2"
          ],
          "what": "Limits which user or team roles may create personal or team keys, and can require params.",
          "setting": "litellm_settings.key_generation_settings",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-c8c961a5"
          ]
        },
        {
          "name": "upperbound_key_generate_params",
          "effect": "limit_lifetime",
          "applies_to": [
            "litellm-2"
          ],
          "what": "Rejects key requests above a max duration, budget or rate limit.",
          "setting": "litellm_settings.upperbound_key_generate_params",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-c8c961a5"
          ]
        },
        {
          "name": "custom_key_policy",
          "effect": "limit_lifetime",
          "applies_to": [
            "litellm-2",
            "litellm-3"
          ],
          "what": "Custom Python hook that can deny any key create, update or regenerate (e.g. require expiry within 7 days).",
          "setting": "general_settings.custom_key_policy",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-c8c961a5"
          ]
        },
