      "scope_notes": "Twilio cloud APIs; PKCV needs Enterprise or Security Edition, OAuth apps are US1-only, and Monitor Events keeps 30 days (13 months with Administration, Security or Enterprise Edition).",
      "controls": [
        {
          "name": "Restricted API key permissions",
          "effect": "limit_scope",
          "applies_to": [
            "twilio-2"
          ],
          "what": "Key can call only selected endpoints/actions.",
          "setting": "Console > API keys & auth tokens > Create API key > Restricted; POST https://iam.twilio.com/v1/Keys",
          "plan": null,
          "default": "off",
          "level": "app",
          "evidence_refs": [
            "fc-eacccdbf"
          ]
        },
        {
          "name": "Delete API key",
          "effect": "revoke",
          "applies_to": [
            "twilio-2",
            "twilio-6"
          ],
          "what": "Revokes REST access and invalidates Access Tokens signed with the key.",
          "setting": "Console > API keys > Delete this key; DELETE https://iam.twilio.com/v1/Keys/{Sid}",
          "plan": null,
          "default": "unknown",
          "level": "app",
          "evidence_refs": [
            "fc-32e1fe85",
            "fc-e7df353d"
          ]
        },
        {
          "name": "Suspend or close subaccount",
          "effect": "disable",
          "applies_to": [
            "twilio-1",
            "twilio-2"
          ],
          "what": "Stops a subaccount; closed subaccounts are deleted after 30 days by default.",
          "setting": "POST https://api.twilio.com/2010-04-01/Accounts/{Sid}.json Status=suspended|closed",
          "plan": null,
          "default": "unknown",
          "level": "account",
          "evidence_refs": [
            "fc-5a243e1d"
          ]
        }
      ],
