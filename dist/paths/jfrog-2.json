  "providers": [
    {
      "id": "jfrog",
      "name": "JFrog",
      "scope_notes": "Covers JFrog Platform (Cloud/SaaS). JFrog Cloud SaaS; IP allowlist, OIDC integration and MyJFrog API tokens need Enterprise X or Enterprise+, log streaming needs Enterprise+, Cloud Log Collection is on all SaaS licenses; several token thresholds are documented only as self-hosted YAML settings.",
      "controls": [
        {
          "name": "Revoke Token by ID / Access Tokens page",
          "effect": "revoke",
          "applies_to": [
            "jfrog-1",
            "jfrog-2"
          ],
          "what": "Admin revokes any token; users revoke their own.",
          "setting": "Administration > User Management > Access Tokens; DELETE /access/api/v1/tokens/{tokenId}",
          "plan": null,
          "default": "varies",
          "level": "org",
          "evidence_refs": [
            "fc-91713033"
          ]
        },
        {
          "name": "Revoke Token by Value",
          "effect": "revoke",
          "applies_to": [
            "jfrog-1",
            "jfrog-2"
          ],
          "what": "Admin revokes a leaked JWT or reference token by its value.",
          "setting": "POST /access/api/v1/tokens/revoke",
          "plan": null,
          "default": "varies",
          "level": "org",
          "evidence_refs": [
            "fc-4dae0227"
          ]
        },
        {
          "name": "Token default expiry",
          "effect": "limit_lifetime",
          "applies_to": [
            "jfrog-1",
            "jfrog-2"
          ],
          "what": "Sets the default expiry for new tokens.",
          "setting": "PUT /access/api/v1/config/token/default_expiry",
          "plan": null,
          "default": "on",
          "level": "org",
          "evidence_refs": [
            "fc-e23d8f15",
            "fc-b5410fc6"
          ]
        },
        {
          "name": "token.max-expiry",
          "effect": "limit_lifetime",
          "applies_to": [
            "jfrog-1",
            "jfrog-2"
          ],
          "what": "Caps non-admin token lifetime and blocks non-expiring tokens when set above 0.",
          "setting": "access.config YAML token.max-expiry (default 0 = no limit)",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-b5410fc6"
          ]
        },
        {
          "name": "IP/CIDR Allowlist",
          "effect": "limit_network",
          "applies_to": [
            "jfrog-1",
            "jfrog-2",
            "jfrog-3",
            "jfrog-4"
          ],
          "what": "Only listed IPs/JPDs can reach the JPD.",
          "setting": "MyJFrog > Security > Allowlist; MyJFrog IP allowlist API",
          "plan": "Enterprise X or Enterprise+",
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-54c4dbf6"
          ]
        },
        {
          "name": "Disable/delete user (with SCIM)",
          "effect": "revoke",
          "applies_to": [
            "jfrog-2",
            "jfrog-1"
          ],
          "what": "Deleting or disabling a user revokes their identity tokens; SCIM pushes IdP deprovisioning.",
          "setting": "User Management > Users; SCIM",
          "plan": null,
          "default": "varies",
          "level": "user",
          "evidence_refs": [
            "fc-b123d5cd",
            "fc-f71d8e4b"
          ]
        },
        {
          "name": "Allow Created Users Access To Profile Page",
          "effect": "disable",
          "applies_to": [
            "jfrog-2",
            "jfrog-3"
          ],
          "what": "When cleared, users auto-created through SAML cannot reach their profile page, where identity tokens and API keys are generated.",
          "setting": "Administration > Authentication Providers > SAML SSO settings",
          "plan": null,
          "default": "unknown",
          "level": "org",
          "evidence_refs": [
            "fc-6f4d8fc5",
            "fc-b123d5cd"
          ]
        }
      ],
