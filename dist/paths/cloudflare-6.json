            "fc-8d72ca7d",
            "fc-54356738"
          ]
        },
        {
          "name": "Delete / roll API token",
          "effect": "revoke",
          "applies_to": [
            "cloudflare-1",
            "cloudflare-2",
            "cloudflare-6"
          ],
          "what": "Deleting or rolling invalidates the token secret.",
          "setting": "DELETE /user/tokens/{token_id}; DELETE /accounts/{account_id}/tokens/{token_id}; PUT /user/tokens/{token_id}/value",
          "plan": null,
          "default": "unknown",
          "level": "app",
          "evidence_refs": [
            "fc-2543f505",
            "fc-1cffa3ce",
            "fc-389be483",
            "fc-7df6eed0"
          ]
        }
      ],
