  "scope": "Admin controls, logging and revocation for API credentials on SaaS platforms. Sourced from vendor documentation; not an audit of any tenant.",
  "definitions": {
    "supported": "Documented for this credential.",
    "conditional": "Documented, with plan, policy or endpoint conditions.",
    "excluded": "The named control explicitly does not cover this credential.",
    "not_supported": "Vendor documentation states this credential lacks the control.",
    "unknown": "No source found either way. Not a negative finding.",
    "not_verified": "No source found either way. Not a negative finding.",
    "not_applicable": "Does not apply to this credential.",
    "limited": "Documented for a narrower case only."
  },
  "providers": [
    {
      "id": "litellm",
      "name": "LiteLLM",
      "scope_notes": "Covers LiteLLM Proxy (AI Gateway). Self-hosted open-source proxy (MIT) with an Enterprise license gating JWT auth, IP filtering, audit logs and key rotation; all controls are operator config on your own deployment.",
      "controls": [
        {
          "name": "allowed_ips",
          "effect": "limit_network",
          "applies_to": [
            "litellm-1",
            "litellm-2",
            "litellm-3",
            "litellm-4"
          ],
          "what": "Only listed client IPs can call proxy endpoints; others get 403.",
          "setting": "general_settings.allowed_ips",
          "plan": "Enterprise",
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-3e5f4bbf"
          ]
        },
        {
          "name": "disable_env_credential_login",
          "effect": "other",
          "applies_to": [
            "litellm-1"
          ],
          "what": "Stops the master key and UI_USERNAME/UI_PASSWORD from logging into the Admin UI; API use of the master key continues.",
          "setting": "general_settings.disable_env_credential_login: true",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-0395d3df"
          ]
        },
        {
          "name": "Master key rotation",
          "effect": "revoke",
          "applies_to": [
            "litellm-1"
          ],
          "what": "Replace the master key value and restart every proxy instance.",
          "setting": "LITELLM_MASTER_KEY / general_settings.master_key; POST /key/regenerate with new_master_key when no salt key",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-7d6648d7"
          ]
        },
        {
          "name": "store_audit_logs",
          "effect": "other",
          "applies_to": [
            "litellm-1",
            "litellm-2",
            "litellm-3"
          ],
          "what": "Records create/update/delete/regenerate of keys, teams, users, models.",
          "setting": "litellm_settings.store_audit_logs",
          "plan": "Enterprise",
          "default": "varies",
          "level": "org",
          "evidence_refs": [
            "fc-34776e02"
          ]
        }
      ],
      "no_control": [
        {
          "path_id": "litellm-1",
          "what": "Failed-login rate limiting does not cover use of the master key as an API bearer token.",
          "kind": "other",
          "evidence_refs": [
            "fc-0395d3df"
          ]
        },
        {
          "path_id": "litellm-1",
          "what": "Disabling env-credential UI login does not stop the master key on the API.",
          "kind": "disable",
          "evidence_refs": [
            "fc-0395d3df"
          ]
        }
      ],
      "controls_unknown": [
        "Whether /key/delete and /key/block take effect instantly or after an auth-cache TTL (only SCIM deprovisioning is documented as clearing the cache).",
        "Master key expiry and SCIM token expiry, rotation and revocation steps.",
        "Whether management GET calls (/key/info, /key/list, /spend/logs) are logged anywhere besides server logs.",
        "Whether allowed_ips applies to /scim routes."
      ]
    }
  ],
