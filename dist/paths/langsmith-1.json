{
  "schema_version": "2.0.0",
  "title": "API Token Controls",
  "as_of": "2026-10-09",
  "updated": "2026-10-14",
  "scope": "Admin controls, logging and revocation for API credentials on SaaS platforms. Sourced from vendor documentation; not an audit of any tenant.",
  "definitions": {
    "supported": "Documented for this credential.",
    "conditional": "Documented, with plan, policy or endpoint conditions.",
    "excluded": "The named control explicitly does not cover this credential.",
    "not_supported": "Vendor documentation states this credential lacks the control.",
    "unknown": "No source found either way. Not a negative finding.",
    "not_verified": "No source found either way. Not a negative finding.",
    "not_applicable": "Does not apply to this credential.",
    "limited": "Documented for a narrower case only."
  },
  "providers": [
    {
      "id": "langsmith",
      "name": "LangSmith",
      "scope_notes": "Covers LangSmith (LangChain). SaaS (US/EU regions) plus self-hosted and BYOC; audit logs, SCIM and service-key roles are Enterprise, Viewer role needs Plus/Enterprise.",
      "controls": [
        {
          "name": "pat_creation_disabled",
          "effect": "disable",
          "applies_to": [
            "langsmith-1"
          ],
          "what": "Stops anyone in the org creating new PATs.",
          "setting": "PATCH /api/v1/orgs/current/info (API only)",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-315666e6"
          ]
        },
        {
          "name": "Global PAT creation disable (self-hosted)",
          "effect": "disable",
          "applies_to": [
            "langsmith-1"
          ],
          "what": "Env var disables PAT creation across all orgs on a self-hosted install.",
          "setting": "Helm environment variable",
          "plan": "Self-hosted",
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-315666e6"
          ]
        },
        {
          "name": "Organization Viewer role",
          "effect": "disable",
          "applies_to": [
            "langsmith-1"
          ],
          "what": "Users with this role cannot create PATs.",
          "setting": "Org member role",
          "plan": "Plus or Enterprise",
          "default": "off",
          "level": "user",
          "evidence_refs": [
            "fc-2ccacbe4"
          ]
        },
        {
          "name": "Deactivate PAT (revocation)",
          "effect": "disable",
          "applies_to": [
            "langsmith-1"
          ],
          "what": "Stops a PAT authenticating; reversible.",
          "setting": "Settings > API Keys > Personal; POST /api/v1/orgs/current/personal-access-tokens/{pat_id}/revocation",
          "plan": null,
          "default": "off",
          "level": "user",
          "evidence_refs": [
            "fc-8ad90fe7",
            "fc-78902130",
            "fc-6c3e32a9"
          ]
        },
        {
          "name": "Delete PAT",
          "effect": "revoke",
          "applies_to": [
            "langsmith-1"
          ],
          "what": "Permanently removes a PAT.",
          "setting": "Settings > API Keys; DELETE /api/v1/orgs/current/personal-access-tokens/{pat_id}",
          "plan": null,
          "default": "off",
          "level": "user",
          "evidence_refs": [
            "fc-8ad90fe7"
          ]
        },
        {
          "name": "Key expiration",
          "effect": "limit_lifetime",
          "applies_to": [
            "langsmith-1",
            "langsmith-2"
          ],
          "what": "Per-key expiry in days; default never.",
          "setting": "API key create dialog",
          "plan": null,
          "default": "off",
          "level": "app",
          "evidence_refs": [
            "fc-8ad90fe7",
            "fc-2ccacbe4"
          ]
        },
        {
          "name": "max_pat_expiry_days / max_service_key_expiry_days",
          "effect": "limit_lifetime",
          "applies_to": [
            "langsmith-1",
            "langsmith-2"
          ],
          "what": "Org-level maximum expiry fields in the org API schema (behaviour not described in guides).",
          "setting": "PATCH /api/v1/orgs/current/info",
          "plan": null,
          "default": "unknown",
          "level": "org",
          "evidence_refs": [
            "fc-9cdc042c"
          ]
        },
        {
          "name": "Remove user from org / SCIM deprovision",
          "effect": "revoke",
          "applies_to": [
            "langsmith-1"
          ],
          "what": "PATs stop working once the user is removed from the organization.",
          "setting": "Org members or IdP SCIM",
          "plan": null,
          "default": "off",
          "level": "org",
          "evidence_refs": [
            "fc-2ccacbe4",
            "fc-b3558a37"
          ]
        }
      ],
      "no_control": [],
      "controls_unknown": [
        "What ip_allowlist covers and whether it applies to API key requests",
