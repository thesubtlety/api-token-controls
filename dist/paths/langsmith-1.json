  "auth_paths": [
    {
      "id": "langsmith-1",
      "provider_id": "langsmith",
      "name": "Personal Access Tokens (PATs)",
      "family": "pat",
      "principal": "user",
      "lifecycle": "current",
      "reviewed_at": "2026-10-12",
      "authentication": {
        "summary": "User-created keys (lsv2_pt_) sent as X-API-Key; they carry the creating user's permissions and default workspace.",
        "evidence_refs": [
          "fc-8ad90fe7",
          "fc-2ccacbe4"
        ]
      },
      "federation": {
        "status": "not_verified",
        "details": "SSO-only enforcement is documented for logins; docs do not say whether PATs are blocked by it. PATs stop working if the user is removed from the org (e.g. via SCIM).",
        "evidence_refs": [
          "fc-b3558a37",
          "fc-2ccacbe4"
        ]
      },
      "ip_restriction": {
        "status": "unknown",
        "enforcement_stage": "unknown",
        "boundary": "Org API schema has an ip_allowlist field, but no doc describes what it covers.",
        "evidence_refs": [
          "fc-9cdc042c"
        ]
      },
      "lifetime": {
        "basis": "absolute",
        "default_seconds": null,
        "maximum_seconds": null,
        "configurable": "yes",
        "summary": "Never expires by default; optional days; org field max_pat_expiry_days",
        "evidence_refs": [
          "fc-8ad90fe7",
          "fc-2ccacbe4",
          "fc-9cdc042c"
        ]
      },
      "renewal": {
        "mechanism": "new_token",
        "expiry_basis": "expiry date",
        "summary": "Expired keys cannot be extended; create a new one.",
        "evidence_refs": [
          "fc-2ccacbe4"
        ]
      },
      "administration": {
        "summary": "Org admins can disable PAT creation (pat_creation_disabled), give users the Viewer role (no PATs), and list, deactivate or delete any member's PAT.",
        "conditions": "Viewer role needs Plus/Enterprise.",
        "evidence_refs": [
          "fc-315666e6",
          "fc-2ccacbe4",
          "fc-8ad90fe7",
          "fc-aa5fd976"
        ]
      },
      "identity": {
