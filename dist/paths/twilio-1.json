  "providers": [
    {
      "id": "twilio",
      "name": "Twilio",
      "scope_notes": "Twilio cloud APIs; PKCV needs Enterprise or Security Edition, OAuth apps are US1-only, and Monitor Events keeps 30 days (13 months with Administration, Security or Enterprise Edition).",
      "controls": [
        {
          "name": "Auth Token rotation (secondary + promote)",
          "effect": "revoke",
          "applies_to": [
            "twilio-1"
          ],
          "what": "Promoting the secondary token deletes the old primary.",
          "setting": "Console > API keys & tokens > Auth Tokens; POST https://accounts.twilio.com/v1/AuthTokens/Secondary, POST https://accounts.twilio.com/v1/AuthTokens/Promote",
          "plan": null,
          "default": "unknown",
          "level": "account",
          "evidence_refs": [
            "fc-8ea50af5",
            "fc-4fc37d61",
            "fc-b7756822"
          ]
        },
        {
          "name": "Enforce Public Key Client Validation",
          "effect": "disable",
          "applies_to": [
            "twilio-1"
          ],
          "what": "Makes the Auth Token invalid for REST requests; requests must be signed with a registered key.",
          "setting": "Console > Settings > Enforce Public Key Client Validation",
          "plan": "Enterprise Edition or Security Edition",
          "default": "off",
          "level": "account",
          "evidence_refs": [
            "fc-05d9e1e1",
            "fc-103e8def"
          ]
        },
        {
          "name": "Suspend or close subaccount",
          "effect": "disable",
          "applies_to": [
            "twilio-1",
            "twilio-2"
          ],
          "what": "Stops a subaccount; closed subaccounts are deleted after 30 days by default.",
          "setting": "POST https://api.twilio.com/2010-04-01/Accounts/{Sid}.json Status=suspended|closed",
          "plan": null,
          "default": "unknown",
          "level": "account",
          "evidence_refs": [
            "fc-5a243e1d"
          ]
        }
      ],
      "no_control": [],
      "controls_unknown": [
        "IP allowlisting for REST API credentials (Auth Token, API keys, OAuth).",
        "Expiry settings for API keys and Auth Tokens.",
        "Whether org SSO enforcement or SCIM deactivation affects any API credential.",
