{
  "schema_version": "2.0.0",
  "title": "API Token Controls",
  "as_of": "2026-10-09",
  "updated": "2026-10-14",
  "scope": "Admin controls, logging and revocation for API credentials on SaaS platforms. Sourced from vendor documentation; not an audit of any tenant.",
  "definitions": {
    "supported": "Documented for this credential.",
    "conditional": "Documented, with plan, policy or endpoint conditions.",
    "excluded": "The named control explicitly does not cover this credential.",
    "not_supported": "Vendor documentation states this credential lacks the control.",
    "unknown": "No source found either way. Not a negative finding.",
    "not_verified": "No source found either way. Not a negative finding.",
    "not_applicable": "Does not apply to this credential.",
    "limited": "Documented for a narrower case only."
  },
  "providers": [
    {
      "id": "cloudflare",
      "name": "Cloudflare",
      "scope_notes": "Covers Cloudflare (API, Zero Trust Access, R2). All plans have API tokens and 18-month Audit Logs v2; Logpush beyond 18 months is Enterprise; Access service tokens need Cloudflare Zero Trust; R2 credentials need R2.",
      "controls": [
        {
          "name": "Client IP Address Filtering",
          "effect": "limit_network",
          "applies_to": [
            "cloudflare-1",
            "cloudflare-2"
          ],
          "what": "Token only works from listed CIDRs (verify endpoint excepted).",
          "setting": "API token > Client IP Address Filtering; condition.request.ip",
          "plan": null,
          "default": "off",
          "level": "app",
          "evidence_refs": [
            "fc-30d87826",
            "fc-0165b637"
          ]
        },
        {
          "name": "TTL (not_before / expires_on)",
          "effect": "limit_lifetime",
          "applies_to": [
            "cloudflare-1",
            "cloudflare-2"
          ],
          "what": "Sets when a token starts and stops being valid.",
          "setting": "API token > TTL",
          "plan": null,
          "default": "off",
          "level": "app",
          "evidence_refs": [
            "fc-30d87826",
            "fc-8d72ca7d",
            "fc-0165b637"
          ]
        },
        {
          "name": "Token permissions and resources",
          "effect": "limit_scope",
          "applies_to": [
            "cloudflare-1",
            "cloudflare-2",
            "cloudflare-6"
          ],
          "what": "Limits a token to chosen permission groups, accounts, zones or R2 buckets.",
          "setting": "API token > Permissions / Resources",
          "plan": null,
          "default": "varies",
          "level": "app",
          "evidence_refs": [
            "fc-f816803c",
            "fc-8d72ca7d",
            "fc-54356738"
          ]
        },
        {
          "name": "Delete / roll API token",
          "effect": "revoke",
          "applies_to": [
            "cloudflare-1",
            "cloudflare-2",
            "cloudflare-6"
          ],
          "what": "Deleting or rolling invalidates the token secret.",
          "setting": "DELETE /user/tokens/{token_id}; DELETE /accounts/{account_id}/tokens/{token_id}; PUT /user/tokens/{token_id}/value",
          "plan": null,
          "default": "unknown",
          "level": "app",
          "evidence_refs": [
            "fc-2543f505",
            "fc-1cffa3ce",
            "fc-389be483",
            "fc-7df6eed0"
          ]
        },
        {
          "name": "Remove member from account",
          "effect": "revoke",
          "applies_to": [
            "cloudflare-1"
          ],
          "what": "User tokens become inactive when the user is removed.",
          "setting": "Manage Account > Members",
          "plan": null,
          "default": "unknown",
          "level": "account",
          "evidence_refs": [
            "fc-54356738"
          ]
        },
        {
          "name": "Leaked token detection (GitHub Secret Scanning)",
          "effect": "revoke",
          "applies_to": [
            "cloudflare-1",
            "cloudflare-2",
            "cloudflare-3"
          ],
          "what": "Tokens leaked in public GitHub repos are auto-revoked; private-repo leaks only notify.",
          "setting": "Automatic",
          "plan": null,
          "default": "on",
          "level": "org",
          "evidence_refs": [
            "fc-56457d26"
          ]
        },
        {
          "name": "Enable API Access / API Access (member-level)",
          "effect": "disable",
          "applies_to": [
            "cloudflare-1",
            "cloudflare-3"
          ],
          "what": "Enterprise Super Administrators can turn off API access for the whole account or for specific members; member settings override the account setting.",
          "setting": "Members page > Enable API Access; per member: API Access",
          "plan": "Enterprise",
          "default": "unknown",
          "level": "account",
          "evidence_refs": [
            "fc-a5a16d07"
          ]
        }
      ],
